# Gemini server-side API key. The app works without it using deterministic demo responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Lumo Live (Track 05 : Open Track). Ephemeral tokens are minted server-side; never put the API key in the browser.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Affective dialog only works on 2.5 Live family, not on 3.1. Keep false unless you switch models.
ENABLE_AFFECTIVE_DIALOG=false

# Optional Firebase web config. If any value is missing, RememberMe runs in local Demo Mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional SOS delivery. Without these, SOS is recorded and shown in demo mode but no real SMS/call is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_EMERGENCY_TO=
TWILIO_ENABLE_CALLS=true
